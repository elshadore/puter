[global]
    font = IosevkaNerdFontMono 10

    width = (300, 300)
    height = (0, 800)

    offset = (6, 34)

    origin = bottom-right
    follow = mouse
    monitor = 1

    padding = 12
    horizontal_padding = 12

    frame_width = 1

    gap_size = 8

    markup = full
    format = "<b>%s</b>\n%b"

    alignment = left
    vertical_alignment = center

[urgency_low]
    background = "#010007"
    foreground = "#eee7f0"
    frame_color = "#18132d"
    timeout = 10
    default_icon = dialog-information

[urgency_normal]
    background = "#010007"
    foreground = "#eee7f0"
    frame_color = "#a871c1"
    timeout = 10
    override_pause_level = 30
    default_icon = dialog-information

[urgency_critical]
    background = "#010007"
    foreground = "#eee7f0"
    frame_color = "#f55b64"
    timeout = 0
    override_pause_level = 60
    default_icon = dialog-warning