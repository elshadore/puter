set $mod Mod4
font pango:IosevkaNerdFontMono 11

exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

## SEMAN Server
#
# SEMAN Config:
# ~/.config/seman/.semanrc
exec --no-startup-id seman server-start
# Uses the following watchdog script:
# This makes sure SEMAN server closes when i3 exits.
# ~/puter/scriptz/seman-watchdog
exec_always --no-startup-id seman-watchdog

## Workspaces Bound to Monitors
workspace "0" output HDMI-1
workspace "1" output HDMI-1
workspace "9" output HDMI-2

## Background Applications
# exec --no-startup-id steam -silent
# exec --no-startup-id qbittorrent

## Startup Applications
exec --no-startup-id i3-msg 'workspace "0"; exec emacs'
exec --no-startup-id i3-msg 'workspace "1"; exec firefox'
exec --no-startup-id i3-msg 'workspace "9"; exec alacritty -e btop'
exec --no-startup-id i3-msg 'workspace "0"'

bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

floating_modifier $mod

title_align center
tiling_drag modifier titlebar

gaps inner 4
gaps outer 2

bindsym $mod+Return exec "alacritty"
bindsym $mod+e exec "emacs"
bindsym $mod+w kill

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+period focus output right
bindsym $mod+comma focus output left
bindsym $mod+greater move workspace to output right
bindsym $mod+less move workspace to output left

workspace_layout default

bindsym $mod+n split h
bindsym $mod+v split v

bindsym $mod+f fullscreen toggle
bindsym $mod+y layout stacking
bindsym $mod+t layout tabbed
bindsym $mod+s layout toggle split

bindsym $mod+space floating toggle
bindsym $mod+tab focus mode_toggle
bindsym $mod+a focus parent
bindsym $mod+d focus child

for_window [all] border normal 1
# default_border pixel 1
# default_floating_border pixel 1

# class                 border  backgr. text    indicator child_border
client.focused          #010004 #010007 #fcbcff #010004 #010004
client.focused_inactive #010004 #010007 #9d969e #010004 #010004
client.unfocused        #010004 #010007 #9d969e #010004 #010004
client.urgent           #010004 #010007 #ff2d39 #010004 #010004
client.placeholder      #000000 #010007 #9d969e #000000 #000000

client.background       #ffffff

set $ws1 "0"
set $ws2 "1"
set $ws3 "2"
set $ws4 "3"
set $ws5 "4"
set $ws6 "5"
set $ws7 "6"
set $ws8 "7"
set $ws9 "8"
set $ws10 "9"

bindsym $mod+grave workspace number $ws1
bindsym $mod+1 workspace number $ws2
bindsym $mod+2 workspace number $ws3
bindsym $mod+3 workspace number $ws4
bindsym $mod+4 workspace number $ws5
bindsym $mod+5 workspace number $ws6
bindsym $mod+6 workspace number $ws7
bindsym $mod+7 workspace number $ws8
bindsym $mod+8 workspace number $ws9
bindsym $mod+9 workspace number $ws10

bindsym $mod+Shift+grave move container to workspace number $ws1
bindsym $mod+Shift+1 move container to workspace number $ws2
bindsym $mod+Shift+2 move container to workspace number $ws3
bindsym $mod+Shift+3 move container to workspace number $ws4
bindsym $mod+Shift+4 move container to workspace number $ws5
bindsym $mod+Shift+5 move container to workspace number $ws6
bindsym $mod+Shift+6 move container to workspace number $ws7
bindsym $mod+Shift+7 move container to workspace number $ws8
bindsym $mod+Shift+8 move container to workspace number $ws9
bindsym $mod+Shift+9 move container to workspace number $ws10

bindsym $mod+Shift+r reload
bindsym $mod+Shift+c restart
bindsym $mod+Shift+q exec i3-msg exit 

mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt

    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

bar {
    status_command i3status
    tray_output HDMI-1
    separator_symbol " | "
    colors {
        background #050311
        statusline #eee7f0
        separator #fa7bff

        focused_workspace  #0c0723 #18132d #fcbcff
        active_workspace   #0c0723 #18132d #9d969e
        inactive_workspace #0c0723 #18132d #9d969e
        urgent_workspace   #0c0723 #18132d #ff2d39
        binding_mode       #98ff8a #18132d #98ff8a
    }
}
