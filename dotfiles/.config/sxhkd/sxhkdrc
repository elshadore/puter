super + i
      xcolor | xclip -selection clipboard

super + Print
      scrot -s -e 'mkdir -p ~/Pictures/screenshots; mv $f ~/Pictures/screenshots/'

super + semicolon
      rofi -show drun -show-icons
      
super + m
      rofi -show window -show-icons

super + slash
      dunstctl close
      
super + shift + slash
      dunstctl close-all