// -*- mode: jsonc -*-
{
    "layer": "top",
    "height": 33,
    "spacing": 4,
    "margin-top": 4,
    "margin-bottom": 4,
    "margin-left": 4,
    "margin-right": 4,
    "output": "HDMI-A-1",
    "reload_style_on_change": true,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["cpu", "memory", "pulseaudio", "clock", "tray"],
    "hyprland/workspaces": {
        "all-outputs": true,
        "on-click": "activate",
        "format": "{name}",
        "active-only": true
    },
    "hyprland/window": {
        "max-length": 64
    },
    "cpu": {
        "interval": 1,
        "format": "🔥 {usage}%"
    },
    "memory": {
        "interval": 1,
        "format": "💾 {percentage}%"
    },
    "pulseaudio": {
        "format": "🔊 {volume}%",
        "format-muted": "🔈",
        "format-source": "🔊 {volume}%",
        "format-source-muted": "🔈"
    },
    "clock": {
        "interval": 1,
        "format": "{:%A %d-%m-%Y %H:%M:%S}",
        "tooltip-format": "<small>{calendar}</small>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "format": {
                "months":     "<span color='#ffead3'><b>{}</b></span>",
                "days":       "<span color='#ecc6d9'>{}</span>",
                "weeks":      "<span color='#99ffdd'>W{}</span>",
                "weekdays":   "<span color='#91f4fe'>{}</span>",
                "today":      "<span color='#f734c0'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "tray": {
        "spacing": 8
    },
}
