#!/bin/sh

download() {
    yt-dlp --no-playlist -f bestaudio -x --audio-format mp3 --audio-quality 330k "$1"
}

usage() {
    echo "usage: $0 [-f <file>] [<youtube-url>]"
    exit 1
}

while getopts "f:h" opt; do
    case $opt in
        f)
            file="$OPTARG"
            if [ ! -f "$file" ]; then
                echo "error: file '$file' not found" >&2
                exit 1
            fi
            grep -v '^\s*$' "$file" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | \
                xargs -P "$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)" -I {} \
                yt-dlp --no-playlist -f bestaudio -x --audio-format mp3 --audio-quality 330k {}
            exit 0
            ;;
        h)
            usage
            ;;
        *)
            usage
            ;;
    esac
done

shift $((OPTIND - 1))

if [ "$#" -eq 1 ]; then
    download "$1"
else
    usage
fi

